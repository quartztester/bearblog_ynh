#!/bin/bash

#=================================================
# IMPORT GENERIC HELPERS
#=================================================

source _common.sh
source /usr/share/yunohost/helpers

#=================================================
# INITIALIZE AND STORE SETTINGS
#=================================================

ynh_app_setting_set_default --key=secret_key --value="$(ynh_string_random --length=50)"
ynh_app_setting_set_default --key=analytics_salt --value="$(ynh_string_random --length=32)"

#=================================================
# DOWNLOAD, CHECK AND UNPACK SOURCE
#=================================================
ynh_script_progression "Setting up source files..."

_build_runtime

#=================================================
# APP INITIAL CONFIGURATION
#=================================================
ynh_script_progression "Adding $app's configuration files..."

_render_config

mkdir -p "$data_dir"
chown "$app:$app" "$data_dir"

#=================================================
# INITIALIZE DATA
#=================================================
ynh_script_progression "Initializing the database..."

_bootstrap_data

#=================================================
# SYSTEM CONFIGURATION
#=================================================
ynh_script_progression "Adding system configurations related to $app..."

ynh_config_add_nginx
_add_blogs_nginx

ynh_config_add_systemd

yunohost service add "$app" --description="Bear Blog publishing platform" --log="/var/log/$app/$app.log"

ynh_config_add_logrotate

#=================================================
# START SYSTEMD SERVICE
#=================================================
ynh_script_progression "Starting $app's systemd service..."

ynh_systemctl --service="$app" --action="start" --wait_until="Booting worker"

#=================================================
# END OF SCRIPT
#=================================================

ynh_script_progression "Installation of $app completed"
ynh_print_info "Blog owner: $(ynh_user_get_info --username="$admin" --key=mail) - initial password in $data_dir/admin_credentials.txt - sign in at https://$domain/accounts/login/ (blogs need DNS + wildcard cert for subdomains, see doc/ADMIN.md)"
