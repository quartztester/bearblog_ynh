#!/bin/bash

# load helpers
source _common.sh
source /usr/share/yunohost/helpers

# stop service
ynh_script_progression "Stopping $app's systemd service..."

ynh_systemctl --service="$app" --action="stop"

# downward compat
ynh_script_progression "Ensuring downward compatibility..."

ynh_app_setting_set_default --key=secret_key --value="$(ynh_string_random --length=50)"
ynh_app_setting_set_default --key=analytics_salt --value="$(ynh_string_random --length=32)"

# source
_build_runtime

# update config
ynh_script_progression "Updating $app's configuration files..."

_render_config

# migrate db
ynh_script_progression "Upgrading the database..."

_run_manage "migrate --noinput"
_run_manage "collectstatic --noinput --clear"
ynh_exec_as_app env \
    BB_ADMIN_EMAIL="$(ynh_user_get_info --username="$admin" --key=mail)" \
    BB_ADMIN_PASSWORD="$(cat "$data_dir/admin_credentials.txt" 2>/dev/null || echo unused)" \
    bash -c "cd '$install_dir' && .venv/bin/python manage.py shell" < "$YNH_APP_BASEDIR/conf/bootstrap.py"

# reapply system config
ynh_script_progression "Upgrading system configurations related to $app..."

ynh_config_add_nginx
_add_blogs_nginx

ynh_config_add_systemd

yunohost service add "$app" --description="Bear Blog publishing platform" --log="/var/log/$app/$app.log"

ynh_config_add_logrotate

# start service
ynh_script_progression "Starting $app's systemd service..."

ynh_systemctl --service="$app" --action="start" --wait_until="Booting worker"

ynh_script_progression "Upgrade of $app completed"
