#!/bin/bash

# load helpers
# Relative path: backup/restore scripts run from elsewhere, not from the package dir
source ../settings/scripts/_common.sh
source /usr/share/yunohost/helpers

# restore main dir
ynh_script_progression "Restoring the app main directory..."

_build_runtime

# restore data dir
ynh_script_progression "Restoring the data directory..."

ynh_restore "$data_dir"
chown -R "$app:$app" "$data_dir"

# .env holds domain-specific values -> re-render from settings, not archive
_render_config

# Code rebuilt from package, DB from archive -> align schema
_run_manage "migrate --noinput"

# restore system config
ynh_script_progression "Restoring system configurations related to $app..."

ynh_restore "/etc/nginx/conf.d/$domain.d/$app.conf"
ynh_restore "/etc/nginx/conf.d/$app-blogs.conf"

ynh_restore "/etc/systemd/system/$app.service"
systemctl daemon-reload
systemctl enable "$app.service" --quiet

yunohost service add "$app" --description="Bear Blog publishing platform" --log="/var/log/$app/$app.log"

ynh_restore "/etc/logrotate.d/$app"

# NO trailing slash: ynh_restore data-dir detection misses it, re-applies
# root:root 400 perms -> gunicorn EACCES
ynh_restore "/var/log/$app"

# reload nginx + service
ynh_script_progression "Reloading NGINX web server and $app's service..."

ynh_systemctl --service=nginx --action=reload
ynh_systemctl --service="$app" --action="start"

ynh_script_progression "Restoration completed for $app"
